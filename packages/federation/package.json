{
  "name": "@lcars-gui/federation",
  "version": "0.1.2",
  "description": "LCARS UI components in the style of the Federation (TNG, DS9, Picard) for React and plain HTML/CSS/JS",
  "keywords": [
    "lcars",
    "star-trek",
    "ui",
    "components",
    "react",
    "css",
    "federation"
  ],
  "license": "MIT",
  "author": "aarondnas",
  "homepage": "https://aarondnas.github.io/lcars-gui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aarondnas/lcars-gui.git",
    "directory": "packages/federation"
  },
  "bugs": {
    "url": "https://github.com/aarondnas/lcars-gui/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./global.js": "./dist/index.global.js",
    "./ui.css": "./dist/ui.css",
    "./themes/*.css": "./dist/themes/*.css",
    "./tokens/*": "./tokens/*"
  },
  "files": [
    "dist",
    "tokens"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node build.js && tsup",
    "build:font": "python font-src/build_font.py",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@lcars-gui/core": "^0.1.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@lcars-gui/core",
  "version": "0.1.1",
  "description": "Shared foundation for all lcars-gui factions: sound engine, plain HTML/JS behavior, CSS build",
  "keywords": [
    "lcars",
    "star-trek",
    "ui",
    "sound"
  ],
  "license": "MIT",
  "author": "aarondnas",
  "homepage": "https://aarondnas.github.io/lcars-gui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aarondnas/lcars-gui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/aarondnas/lcars-gui/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./build": "./build/css.js"
  },
  "files": [
    "dist",
    "build"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
